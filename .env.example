# omni-deployer - secrets.env template (code-plan C9 never-commit guardrail)
#
# The deployer reads secrets from `secrets.env` (gitignored, generated
# locally - never committed). This template lists the well-known entries.
# Copy it to `secrets.env` and fill in REAL values; NEVER commit secrets.env
# or any file holding live secrets - the pre-commit hook and CI job
# (scripts/secret-scan.py) block them.
#
# All values below are placeholders (xxxx). Replace every xxxx before use.
# GITHUB_APP_KEY is the multiline PEM private key of the GitHub App used for
# git pushes (populated by the omniagent git plugin at runtime from the
# secrets store; keep the value out of every repo).
POSTGRES_PASSWORD=xxxx
DEEPSEEK_API_KEY=xxxx-your-deepseek-api-key
GITHUB_APP_ID=xxxx
GITHUB_APP_INSTALLATION_ID=xxxx
# GITHUB_APP_KEY=xxxx (multiline PEM; paste only into local secrets.env)
